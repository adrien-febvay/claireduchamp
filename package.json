{
  "name": "claireduchamp",
  "version": "2.12.0",
  "description": "Profesional website for Claire Duchamp, Architect",
  "main": "dist/index.js",
  "scripts": {
    "help": "node webpack help",
    "init": "ts-node -r tsconfig-paths/register src/conf/init",
    "dev": "node webpack dev",
    "tsc": "tsc && rimraf dist-tsc",
    "eslint": "eslint src/**/*.{ts,tsx}",
    "eslint-fix": "eslint **/*/*.{ts,tsx} --fix",
    "stylelint": "stylelint src/**/*.{css,scss}",
    "stylelint-fix": "npm run stylelint -- --fix",
    "test": "npm run tsc && npm run eslint && npm run stylelint",
    "prebuild": "rimraf -g dist-prod-tmp/**/* && node webpack build",
    "postbuild": "rimraf dist-prod && npx cpy-cli \"./dist-prod-tmp/**\" dist-prod/ && rimraf dist-prod-tmp",
    "build": "echo \"Prebuild only, run postbuild to finalize\" && exit 1",
    "preversion": "npm run test -- --silent && npm run prebuild",
    "version": "npm run postbuild && git add dist-prod",
    "start": "node dist-prod/be",
    "clean": "rimraf dist-tsc && rimraf dist-dev && rimraf dist-prod-tmp"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adrien-febvay/claireduchamp.git"
  },
  "author": "Adrien Febvay",
  "bugs": {
    "url": "https://github.com/adrien-febvay/claireduchamp/issues"
  },
  "homepage": "https://github.com/adrien-febvay/claireduchamp#readme",
