{
  "name": "claireduchamp",
  "version": "1.1.6",
  "description": "Claire Duchamp / Architecte",
  "main": "dist/index.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development webpack",
    "stag": "cross-env NODE_ENV=staging webpack",
    "eslint": "eslint src/**/*.ts",
    "eslint-fix": "eslint **/*/*.ts --fix",
    "tsc": "tsc && rimraf tsc",
    "test": "npm run tsc && npm run eslint",
    "prebuild": "rimraf dist-tmp",
    "build": "cross-env NODE_ENV=production webpack --bail",
    "postbuild": "rimraf dist && npx cpy-cli dist-tmp/** dist/",
    "pull-gui": "rimraf src/gui && npx cpy-cli ../claireduchamp-front/dist/** src/gui/",
    "commit-gui": "git add src/gui/ && git commit -m \"Update GUI\"",
    "pull-commit-gui": "npm run pull-gui && npm run commit-gui",
    "preversion": "npm run test -- --silent && npm run build",
    "start": "node ./dist/index.js",
    "v": "node -v"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adrien-febvay/claireduchamp.git"
  },
  "author": "Adrien Febvay",
  "bugs": {
    "url": "https://github.com/adrien-febvay/claireduchamp/issues"
  },
  "homepage": "https://github.com/adrien-febvay/claireduchamp#readme",
  "dependencies": {
    "body-parser": "^1.20.2",
    "cookie-parser": "^1.4.6",
    "express": "^4.18.2",
    "express-http-proxy": "^2.0.0",
    "node": "18.18.0",
    "path-validation": "^0.2.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/body-parser": "^1.19.5",
    "@types/cookie-parser": "^1.4.6",
    "@types/express": "^4.17.21",
    "@types/express-http-proxy": "^1.6.6",
    "@typescript-eslint/eslint-plugin": "^6.18.1",
    "@typescript-eslint/parser": "^6.18.1",
    "copy-webpack-plugin": "^12.0.1",
    "cpy-cli": "^5.0.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-promise": "^6.1.1",
    "nodemon": "^3.0.2",
    "prettier": "^3.2.2",
    "rimraf": "^5.0.5",
    "ts-loader": "^9.5.1",
    "typescript": "^5.3.3",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "webpack-node-externals": "^3.0.0",
    "webpack-shell-plugin-next": "^2.3.1"
  }
}
